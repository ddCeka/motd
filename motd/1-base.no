#!/data/data/com.termux/files/usr/bin/bash

# config
max_usage=99
bar_width=60
# colors
white="\e[39m"
green="\e[1;32m"
red="\e[1;31m"
yellow="\e[1;33m"
cyan="\e[1;36m"
dim="\e[2m"
undim="\e[0m"
NC='\033[0m'
BOLD='\033[1m'
# data
date=$(date +"%A, %d %B %Y")
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# fix loadavg
uptime | grep -Po "average: \K.+"| awk -F", " '{ print $1,$2,$3 }' > $tmp/loadavg
# package
# pkg update > /dev/null 2>&1
if type apt > /dev/null 2>&1; then
    total=$(apt list --installed 2> /dev/null | grep -c installed)
    updates=$(apt list --upgradable 2> /dev/null | grep -c upgradable)
elif type pacman > /dev/null 2>&1; then
    total=$(pacman -Qq 2> /dev/null | wc -l)
    updates=$(pacman -Qu 2>/dev/null | wc -l)
else
    total="N/A"
    updates="N/A"
fi
# get load averages
IFS=" " read LOAD1 LOAD5 LOAD15 <<<$(cat $tmp/loadavg)
# get free memory
IFS=" " read USED AVAIL TOTAL <<<$(free -htm | grep "Mem" | awk {'print $3,$7,$2'})

echo -e "  $cyan$date

${white}${BOLD}System Info: 
$cyan  Uptime    : $green$(uptime -p)
$cyan  Load      : $green$LOAD1$white (1m), $green$LOAD5$white (5m), $green$LOAD15$white (15m)
$cyan  Memory    : $green$USED$white used, $green$AVAIL$white free, $green$TOTAL$white total
$cyan  Package   : $green$total$white total$green installed, $green$updates$white available$green update
"

# disk usage: ignore zfs, squashfs & tmpfs
mapfile -t dfs < <(df -H -t sdcardfs -t fuse -t fuse.rclone | tail -n+2)
printf "${white}${BOLD}Disk Usage:${NC}\n"

for line in "${dfs[@]}"; do
    # get disk usage
    usage=$(echo "$line" | awk '{print $5}' | sed 's/%//')
    used_width=$((($usage*$bar_width)/100))
    # color is green if usage < max_usage, else red
    if [ "${usage}" -ge "${max_usage}" ]; then
        color=$red
    else
        color=$green
    fi
    # print green/red bar until used_width
    bar="[${color}"
    for ((i=0; i<$used_width; i++)); do
        bar+="#"
    done
    # print dimmmed bar until end
    bar+="${cyan}${dim}"
    for ((i=$used_width; i<$bar_width; i++)); do
        bar+="-"
    done
    bar+="${undim}]"
    # print usage line & bar
    echo "${line}" | awk '{ printf("%-31s%+3s used out of %+4s\n", $6, $3, $2); }' | sed -e 's/^//'
    echo -e "${bar}" | sed -e 's/^/  /'
done
