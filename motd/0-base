#!/data/data/com.termux/files/usr/bin/bash

# Dynamic width for mobile screens
cols=$(tput cols 2>/dev/null || echo 50)
bar_width=$((cols - 6))
[ "$bar_width" -lt 20 ] && bar_width=20

printf -v line '%*s' "$cols" ''
line=${line// /}

# Gotham Adapted (TrueColor)
white="\033[38;2;211;235;233m"   # #D3EBE9
green="\033[1;38;2;52;191;160m"  # #34BFA0 (bold emerald teal)
red="\033[1;38;2;217;84;77m"     # #D9544D (bold coral red)
yellow="\033[1;38;2;224;130;86m" # #E08256 (bold warm amber)
cyan="\033[1;38;2;153;209;206m"  # #99D1CE (bold mint aqua)
steel="\033[38;2;89;156;171m"    # #599CAB (steel cyan)
slate="\033[38;2;106;125;140m"   # #6A7D8C (muted slate)
NC='\e[0m'
BOLD='\e[1m'

date_str=$(date +"%A, %d %B %Y")

# Fast load average & memory without temp files
read -r LOAD1 LOAD5 LOAD15 _ < /proc/loadavg
read -r USED AVAIL TOTAL <<< "$(free -htm | awk '/^Mem:/ {print $3, $7, $2}')"

# Android battery status via Termux:API (with 1.5s timeout guard)
bat_line=""
if command -v termux-battery-status >/dev/null 2>&1; then
    bat_json=$(timeout 1.5s termux-battery-status 2>/dev/null)
    if [[ -n "$bat_json" ]]; then
        read -r bat_pct bat_status bat_temp <<< "$(python -c '
import sys, json
d = json.load(sys.stdin)
print(d.get("percentage", 0), d.get("status", "UNKNOWN").capitalize(), round(d.get("temperature", 0), 1))
' <<< "$bat_json" 2>/dev/null)"

        if [[ -n "$bat_pct" ]]; then
            if [ "$bat_pct" -le 20 ]; then
                bat_color=$red
            elif [ "$bat_pct" -le 50 ]; then
                bat_color=$yellow
            else
                bat_color=$green
            fi
            bat_line="\n${cyan}  Battery    : ${bat_color}${bat_pct}%${white} (${bat_status}, ${bat_temp}°C)"
        fi
    fi
fi

# Fast package count + 1-hour cache for upgradable packages
CACHE_FILE="${TMPDIR:-/tmp}/motd_pkg_updates"
if command -v apt >/dev/null 2>&1; then
    total=$(dpkg-query -f '.\n' -W 2>/dev/null | wc -l)
    if [[ ! -f "$CACHE_FILE" ]] || [[ $(find "$CACHE_FILE" -mmin +60 2>/dev/null) ]]; then
        apt list --upgradable 2>/dev/null | grep -c upgradable > "$CACHE_FILE" &
    fi
    updates=$(cat "$CACHE_FILE" 2>/dev/null || echo "...")
elif command -v pacman >/dev/null 2>&1; then
    total=$(pacman -Qq 2>/dev/null | wc -l)
    updates=$(pacman -Qqu 2>/dev/null | wc -l)
else
    total="N/A"
    updates="N/A"
fi

# Header (compact on very narrow split-screens, full ASCII otherwise)
if [ "$cols" -ge 54 ]; then
    echo -e "${steel}${line}${green}
   _     _                  _
  | |   (_)_ __  _   ___  _| |
  | |   | | '_ \| | | \ \/ / |          ${cyan}${date_str}${green}
  | |___| | | | | |_| |>  <|_|
  |_____|_|_| |_|\__,_/_/\_(_)
"
else
    echo -e "${steel}${line}\n${green}Linux${NC}  ${cyan}${date_str}${NC}\n"
fi

echo -e "${white}${BOLD}System Info:${NC}
${cyan}  Uptime     : ${green}$(uptime -p)
${cyan}  Load       : ${green}${LOAD1}${white} (1m), ${green}${LOAD5}${white} (5m), ${green}${LOAD15}${white} (15m)
${cyan}  Memory     : ${green}${AVAIL}${white} free, ${green}${USED}${white} used, ${green}${TOTAL}${white} total${bat_line}
${cyan}  Package    : ${green}${updates}${white} available update, ${green}${total}${white} total installed
"

# Disk usage with dynamic bar width and warning thresholds
mapfile -t dfs < <(df -H -t sdcardfs -t fuse -t fuse.rclone 2>/dev/null | tail -n+2)
printf "${white}${BOLD}Disk Usage:${NC}\n"

for df_line in "${dfs[@]}"; do
    usage=$(echo "$df_line" | awk '{print $5}' | tr -d '%')
    used_width=$(( (usage * bar_width) / 100 ))

    if [ "$usage" -ge 90 ]; then
        color=$red
    elif [ "$usage" -ge 75 ]; then
        color=$yellow
    else
        color=$green
    fi

    printf -v filled '%*s' "$used_width" ''
    filled=${filled// /}
    printf -v empty '%*s' "$((bar_width - used_width))" ''
    empty=${empty// /}

    bar="${color}${filled}${slate}${empty}${color}${NC}"
    echo "$df_line" | awk -v w="$white" -v s="$slate" '{ printf("  %s%-25s%s                  %s%+4sB used of %+4sB\n", w, $6, "\033[0m", s, $3, $2); }'
    echo -e "  ${bar}"
done
