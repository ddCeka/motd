#!/usr/bin/env python3

import datetime
import os
import random
import re
import textwrap

try:
  COL, ROW = os.get_terminal_size()
except OSError:
  # May have run from remote command like `git fetch`
  exit()

# Change from home directory to this directory
os.chdir(os.path.dirname(os.path.abspath(__file__)))

# Gotham Adapted (TrueColor)
ICE      = '\033[38;2;211;235;233m'    # #D3EBE9
MINT     = '\033[1;38;2;153;209;206m'  # #99D1CE (bold)
STEEL    = '\033[1;38;2;89;156;171m'   # #599CAB (bold)
LAVENDER = '\033[3;38;2;156;159;184m'  # #9C9FB8 (italic)
SLATE    = '\033[38;2;106;125;140m'    # #6A7D8C
NC       = '\033[0m'

# MOTD sections
WELCOME = f"""\

{SLATE}Starting on a {{current_day}}{NC}\
"""

QUOTE = f"""\
{STEEL}Message of the day:{NC}

{{quote}}\
"""

# Specify which sections to display
SECTIONS = [
  WELCOME,
  QUOTE,
]

# Constants for use in placeholders
DT = datetime.datetime.now().astimezone()

# Helper functions
def part_of_day():
  h = DT.hour
  if 5 <= h < 9:
    return 'early-morning'
  elif 9 <= h < 12:
    return 'morning'
  elif 12 <= h < 15:
    return 'noon'
  elif 15 <= h < 18:
    return 'afternoon'
  elif 18 <= h < 21:
    return 'evening'
  elif 21 <= h < 24:
    return 'night'
  return 'late-night'

def wrap(text, indent=0):
  """Wraps a string or a list of lines to fit the terminal's width."""
  if isinstance(text, str):
    text = text.splitlines()

  pad = ' ' * max(indent, 0)
  wrapper = textwrap.TextWrapper(
    width=COL,
    drop_whitespace=False,
    replace_whitespace=False,
    initial_indent=pad,
    subsequent_indent=pad
  )

  for i, line in enumerate(text):
    if indent == -1:
      leading = re.match(r'\s*', line).group()
      wrapper.subsequent_indent = leading

    text[i] = wrapper.fill(line)

  return '\n'.join(text)

# Placeholder functions
def get_current_day():
  day_str = DT.strftime(f'%A {part_of_day()}').lower()
  return f'{MINT}{day_str}{SLATE}'

def get_quote():
  with open('database.txt', encoding='utf-8') as f:
    lines = [line.strip() for line in f if line.strip()]

  if not lines:
    return f'{SLATE}{wrap("No quotes found in database.txt.", indent=2)}{NC}'

  epoch = datetime.date.fromtimestamp(0)
  days = (DT.date() - epoch).days

  seed, i = divmod(days, len(lines))
  rand = random.Random(seed)

  rand.shuffle(lines)
  raw_line = lines[i].rstrip()

  # Split quote and author if separated by " - ", " – ", or " — "
  match = re.match(r'^(.*?)(\s+[-–—]\s+.+)$', raw_line)
  if match:
    body, author = match.groups()
    wrapped_body = wrap(body, indent=2)
    wrapped_author = wrap(author.lstrip(), indent=4)
    return f'{ICE}{wrapped_body}\n{LAVENDER}{wrapped_author}{NC}'

  return f'{ICE}{wrap(raw_line, indent=2)}{NC}'

v = {
  'current_day': get_current_day(),
  'quote': get_quote(),
}

# Format and remove empty sections before printing
rendered = [s.format(**v) for s in SECTIONS if s]
message = '\n\n'.join(rendered)
print(message, end='\n\n')
